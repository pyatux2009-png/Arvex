# Existing ArbX cross-exchange engine remains PAPER-only by default.
TRADING_MODE=PAPER
AUTO_EXECUTE=false

# CEX-DEX research profile: public/read-only market data only.
CEX_DEX_ENABLED=true
CEX_DEX_MODE=PAPER
CEX_DEX_SYMBOL=BNBUSDT
CEX_DEX_VIRTUAL_DEPOSIT_USDT=100
CEX_DEX_TEST_DAYS=30
CEX_DEX_BSC_RPC_URL=https://bsc-dataseed.binance.org
CEX_DEX_PANCAKE_V2_FEE_BPS=25
CEX_DEX_MARKETDATA_POLL_SECONDS=2
CEX_DEX_STALE_AFTER_SECONDS=5
CEX_DEX_LOG_INTERVAL_SECONDS=5
CEX_DEX_LOG_PATH=data/cex_dex_marketdata.jsonl

# Local SQLite file in the repository root.
DATABASE_URL=sqlite+aiosqlite:///./crypto_arb.db

# Existing cross-exchange symbols and safety thresholds.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MAX_TRADE_SIZE_USD=100
MAX_DAILY_LOSS_USD=5
MIN_NET_PROFIT_USD=0.05
MIN_NET_PROFIT_PCT=0.10
# MAX_SLIPPAGE_PCT is the rejection ceiling; ESTIMATED_SLIPPAGE_PCT is the round-trip estimate.
MAX_SLIPPAGE_PCT=0.20
ESTIMATED_SLIPPAGE_PCT=0.05
BOOK_MAX_AGE_SECONDS=2.0
OTHER_COSTS_USD=0.0

# Local HTTP development: false. Set true only behind HTTPS.
COOKIE_SECURE=false
