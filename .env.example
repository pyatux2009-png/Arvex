# Keep execution disabled during testing.
TRADING_MODE=PAPER
AUTO_EXECUTE=false
# Required for any LIVE order submission (including background auto-execution).
# Set to a long random secret locally; do not commit the real token.
LIVE_API_TOKEN=
MAX_TRADE_SIZE_USD=100
MAX_DAILY_LOSS_USD=5
MIN_NET_PROFIT_USD=0.05
MIN_NET_PROFIT_PCT=0.10
# Estimated round-trip slippage charged to projected profitability.
ESTIMATED_SLIPPAGE_PCT=0.05
# Safety ceiling, separate from the slippage estimate above.
MAX_SLIPPAGE_PCT=0.20
BOOK_MAX_AGE_SECONDS=2.0
OTHER_COSTS_USD=0.0
# 24 liquid large-cap pairs; only Binance/Bybit routes are execution-supported.
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,LTCUSDT,BCHUSDT,TRXUSDT,DOTUSDT,TONUSDT,XLMUSDT,UNIUSDT,ATOMUSDT,NEARUSDT,ETCUSDT,SUIUSDT,FILUSDT,AAVEUSDT,ARBUSDT,OPUSDT

# Default taker fee estimates; replace with your actual account fees.
BINANCE_TAKER_FEE=0.001
BYBIT_TAKER_FEE=0.001
OKX_TAKER_FEE=0.001
# Conservative estimate for low-volume accounts; verify your tier.
KRAKEN_TAKER_FEE=0.004
